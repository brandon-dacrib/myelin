{
  "name": "messaging",
  "description": "Register, create a room, send a text message, fetch it back by event ID.",
  "steps": [
    {
      "name": "register",
      "method": "POST",
      "path": "/_matrix/client/v3/register",
      "body": {
        "username": "differential_msg_user",
        "password": "correct horse battery staple",
        "auth": {"type": "m.login.dummy"}
      },
      "extract": {"access_token": "$.access_token"}
    },
    {
      "name": "create_room",
      "method": "POST",
      "path": "/_matrix/client/v3/createRoom",
      "auth_token": "{{access_token}}",
      "body": {"preset": "private_chat"},
      "extract": {"room_id": "$.room_id"}
    },
    {
      "name": "send_message",
      "method": "PUT",
      "path": "/_matrix/client/v3/rooms/{{room_id}}/send/m.room.message/differential-txn-1",
      "auth_token": "{{access_token}}",
      "body": {"msgtype": "m.text", "body": "hello from the differential harness"},
      "extract": {"event_id": "$.event_id"}
    },
    {
      "name": "get_message",
      "method": "GET",
      "path": "/_matrix/client/v3/rooms/{{room_id}}/event/{{event_id}}",
      "auth_token": "{{access_token}}"
    }
  ]
}
