{
  "name": "membership",
  "description": "Two users: one creates a room and invites the other, who joins then leaves.",
  "steps": [
    {
      "name": "register_alice",
      "method": "POST",
      "path": "/_matrix/client/v3/register",
      "body": {
        "username": "differential_member_alice",
        "password": "correct horse battery staple",
        "auth": {"type": "m.login.dummy"}
      },
      "extract": {"alice_token": "$.access_token", "alice_id": "$.user_id"}
    },
    {
      "name": "register_bob",
      "method": "POST",
      "path": "/_matrix/client/v3/register",
      "body": {
        "username": "differential_member_bob",
        "password": "correct horse battery staple",
        "auth": {"type": "m.login.dummy"}
      },
      "extract": {"bob_token": "$.access_token", "bob_id": "$.user_id"}
    },
    {
      "name": "create_room",
      "method": "POST",
      "path": "/_matrix/client/v3/createRoom",
      "auth_token": "{{alice_token}}",
      "body": {"preset": "private_chat"},
      "extract": {"room_id": "$.room_id"}
    },
    {
      "name": "invite_bob",
      "method": "POST",
      "path": "/_matrix/client/v3/rooms/{{room_id}}/invite",
      "auth_token": "{{alice_token}}",
      "body": {"user_id": "{{bob_id}}"}
    },
    {
      "name": "bob_joins",
      "method": "POST",
      "path": "/_matrix/client/v3/rooms/{{room_id}}/join",
      "auth_token": "{{bob_token}}",
      "body": {}
    },
    {
      "name": "bob_leaves",
      "method": "POST",
      "path": "/_matrix/client/v3/rooms/{{room_id}}/leave",
      "auth_token": "{{bob_token}}",
      "body": {}
    }
  ]
}
