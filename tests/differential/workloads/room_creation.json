{
  "name": "room_creation",
  "description": "Register a user, create a private room, fetch its state.",
  "steps": [
    {
      "name": "register",
      "method": "POST",
      "path": "/_matrix/client/v3/register",
      "body": {
        "username": "differential_room_owner",
        "password": "correct horse battery staple",
        "auth": {"type": "m.login.dummy"}
      },
      "extract": {"access_token": "$.access_token", "user_id": "$.user_id"}
    },
    {
      "name": "create_room",
      "method": "POST",
      "path": "/_matrix/client/v3/createRoom",
      "auth_token": "{{access_token}}",
      "body": {"name": "Differential Test Room", "preset": "private_chat"},
      "extract": {"room_id": "$.room_id"}
    },
    {
      "name": "room_state",
      "method": "GET",
      "path": "/_matrix/client/v3/rooms/{{room_id}}/state",
      "auth_token": "{{access_token}}"
    }
  ]
}
